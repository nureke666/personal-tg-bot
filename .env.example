# Токен бота от @BotFather (обязательно).
BOT_TOKEN=

# Твой Telegram id. Если пусто — напиши боту /start, он пришлёт id. Бот отвечает только этому человеку.
OWNER_ID=

# Часовой пояс по умолчанию (потом меняется в ⚙️ Настройках).
DEFAULT_TZ=Asia/Almaty

# Где лежит база. В Docker путь задаётся в docker-compose.yml.
DB_PATH=data/bot.db
