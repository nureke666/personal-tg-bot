{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(!.env.example)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(uv run python -m bot*)",
      "Bash(docker compose up*)",
      "Bash(sqlite3:*)",
      "Edit(/.github/workflows/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/pyproject.toml)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(uv sync:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff check:*)",
      "Bash(uv run ruff format:*)",
      "Read(**)"
    ]
  }
}
